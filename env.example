# === Database (PostgreSQL) ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=network_monitor
DB_USERNAME=
DB_PASSWORD=

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# === RabbitMQ ===
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# === JWT ===
# JWT_SECRET: HS256 기준 최소 256비트(32바이트) 이상 권장
# 생성 예시: openssl rand -base64 32
JWT_SECRET=
JWT_ISSUER_URI=

# === MQ Strategy (전략 패턴 스위치) ===
# redis | rabbitmq
MQ_PROVIDER=redis

# === Scanner (Python FastAPI) ===
SCANNER_BASE_URL=http://localhost:8001
